NODE_ENV=development
PORT=8080
# Empty = in-memory (single instance, dev only). Required in production.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=room:

# Official midnight. IANA zone name; never the browser's.
ROOM_TIMEZONE=UTC
ROOM_EPOCH_DATE=2026-03-11

# >= 32 random chars in production (IP hashing). `openssl rand -base64 48`
SERVER_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
# Only behind a proxy you control (Cloudflare / your LB). Enables CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY=false
# Show country codes from CF-IPCountry (requires TRUST_PROXY). Country-level only.
EXPOSE_COUNTRY=false

# turnstile | mock (dev only) | none
CHALLENGE_PROVIDER=mock
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Enables /admin/* when set. Serve admin only on a private network.
ADMIN_TOKEN=
# Protects /metrics when set.
METRICS_TOKEN=

MAX_CONNECTIONS=20000
MAX_CONNECTIONS_PER_IP=16
CONNECT_ATTEMPTS_PER_MIN=40
NEW_SESSIONS_PER_IP_HOUR=60
HISTORY_LIMIT=300
MAX_MESSAGE_LENGTH=500
LOG_LEVEL=info
